generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique // Name acts as the identifier for URL
  
  onboardingCompleted Boolean @default(false)
  preferences         String? // JSON string
  aiConfig            String? // JSON string for Admin overrides { temp, weights, prompt }

  // Learned taste profile (JSON) derived from good/bad ratings, see src/lib/taste-profile.ts
  tasteProfile          String?
  tasteProfileUpdatedAt DateTime?

  views     DailyView[]
  ratings   Rating[]
  shares    Share[]
}

model Quote {
  id          Int      @id @default(autoincrement())
  content     String
  author      String?
  explanation String?
  headline    String?  // 2-5 word title printed on the calendar leaf
  microAction String?  // One concrete, small step for today
  category    String?  // The "Tag" or "Topic"
  tags        String?  // Comma separated
  concepts    String?  // JSON string of { word: definition }
  mode        String?
  format      String?
  perspective String?
  tone        String?
  imageryWorld String?
  rhetoricalDevice String?
  timeHorizon String?
  actionType  String?
  difficulty  String?
  promptVersion String?
  provider    String?
  noveltyScore Float?
  generationTrace String?
  
  generatedAt DateTime @default(now())
  sourceModel String? // "gpt-4o", "mock"
  
  views       DailyView[]
  ratings     Rating[]
  shares      Share[]

  @@index([category])
  @@index([mode])
  @@index([format])
  @@index([tone])
}

model DailyView {
  id        Int      @id @default(autoincrement())
  userId    String
  quoteId   Int
  viewedAt  DateTime @default(now()) // Row creation time (may be a pregeneration, not a real view)

  date      String   // "YYYY-MM-DD"

  // Real engagement tracking: set only when the user actually opens / tears off the leaf
  firstOpenedAt DateTime?
  revealedAt    DateTime?
  openCount     Int       @default(0)

  user      User     @relation(fields: [userId], references: [id])
  quote     Quote    @relation(fields: [quoteId], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  quoteId   Int
  quote     Quote    @relation(fields: [quoteId], references: [id])
  score     Int      // 5 = "gut" (thumbs up), 1 = "schlecht" (thumbs down)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([quoteId])
  @@unique([userId, quoteId])
}

model Share {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  quoteId   Int
  quote     Quote    @relation(fields: [quoteId], references: [id])
  platform  String?
  createdAt DateTime @default(now())
}
