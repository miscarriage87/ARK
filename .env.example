DATABASE_URL="file:./dev.db"
OPENAI_API_KEY="sk-..."
ADMIN_PASSWORD="your-admin-password"

# Required in production: secures /api/cron/pregenerate (header x-cron-key or ?key=)
CRON_API_KEY="your-cron-secret"

# Optional: separate secret for signing admin session cookies (falls back to ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET="another-long-random-string"

# Optional: timezone used for the daily calendar boundary (default Europe/Berlin)
# APP_TIME_ZONE="Europe/Berlin"
